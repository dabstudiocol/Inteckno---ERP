{
  "name": "inteckno-erp-functions",
  "version": "1.0.0",
  "description": "Cloud Functions 2nd Gen API Gateway for AI Tool Use, Diagnostics & Sandbox QA on Inteckno ERP",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "sandbox:seed": "ts-node scripts/sandboxSeed.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "private": true
}
