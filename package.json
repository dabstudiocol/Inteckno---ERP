{
  "name": "inteckno-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-e2e.cjs",
    "test:e2e": "node scripts/test-e2e.cjs",
    "sandbox:seed": "node scripts/sandbox-seed.mjs",
    "sandbox:emulators": "npx firebase-tools emulators:start --only functions,firestore,hosting",
    "ai:gemini": "node scripts/gemini-erp-agent.mjs",
    "deploy": "tsc -b && vite build && npx firebase-tools deploy --only hosting,firestore:rules",
    "deploy:all": "tsc -b && vite build && npx firebase-tools deploy"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
